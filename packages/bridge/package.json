{
  "name": "@teradata-pe/bridge",
  "version": "0.1.0",
  "description": "Framework-agnostic UI integration contracts: event bus, authenticated session, theme channel, shared SWR data cache, asynchronous operations, route validators and HTTP interceptors.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "etc/api-baseline.txt"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "contract-check": "node scripts/contract-check.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.7.2"
  }
}
